def primera_mano():
    lista_mano = []
    for i in range(5):
        x = random.randint(1, 5)
        if x == 1: lista_mano.append("Forest")
        elif x == 2: lista_mano.append("Mountain")
        elif x == 3: lista_mano.append("Island")
        elif x == 4: lista_mano.append("Plains")
        elif x == 5: lista_mano.append("Swamp")
    return lista_mano

def reiniciar_juego():
    global lista_mano_1, lista_mano_2, cartas_campo_p1, cartas_campo_p2
    global cartas_descarte_p1, cartas_descarte_p2, turno1, Nrobos, cartas_jugadas_turno, modo_destruir, modo_revivir, modo_swamp, modo_bounce
    lista_mano_1 = primera_mano()
    lista_mano_2 = primera_mano()
    cartas_campo_p1 = []
    cartas_campo_p2 = []
    cartas_descarte_p1 = []
    cartas_descarte_p2 = []
    turno1 = random.choice([True, False])
    Nrobos = 1 
    cartas_jugadas_turno = 0
    modo_destruir = False
    modo_revivir = False
    modo_swamp = False
    modo_bounce = False

    jugador_inicio = nombre_p1 if turno1 else nombre_p2
    popup_mensaje(f"¡Sorteo! Empieza {jugador_inicio} (no roba en su primer turno)")
    pygame.time.delay(2000)

def verificar_victoria(campo_jugador):
    if len(campo_jugador) == 0:
        return False, ""
    
    conteo_cartas = {}
    for carta in campo_jugador:
        conteo_cartas[carta] = conteo_cartas.get(carta, 0) + 1
        if conteo_cartas[carta] >= 5:
            return True, f"¡Consiguió 5 cartas de {carta}!"

    tipos_unicos = set(campo_jugador)
    if len(tipos_unicos) >= 5:
        return True, "¡Consiguió las 5 tierras diferentes!"

    return False, ""

def popup_mensaje(mensaje_texto):
    fuente = pygame.font.Font(None, 26)
    oscurecer = pygame.Surface(screen.get_size(), pygame.SRCALPHA)
    oscurecer.fill((0, 0, 0, 150))
    screen.blit(oscurecer, (0, 0))

    caja = pygame.Rect((ANCHO_PANTALLA - 520) // 2, (ALTO_PANTALLA - 120) // 2, 520, 120)
    pygame.draw.rect(screen, (50, 50, 50), caja)
    pygame.draw.rect(screen, (255, 255, 255), caja, 3)

    mensaje = fuente.render(mensaje_texto, True, (255, 255, 255))
    texto_rect = mensaje.get_rect(center=caja.center)
    screen.blit(mensaje, texto_rect)
    pygame.display.flip()

running = True
lista_mano_1 = primera_mano()
lista_mano_2 = primera_mano()
Nrobos = 0

while running:
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN and ESTADO_JUEGO == "NOMBRES":
            if caja_p1_activa:
                if event.key == pygame.K_BACKSPACE:
                    nombre_p1 = nombre_p1[:-1]
                elif len(nombre_p1) < 12 and event.unicode.isprintable():
                    nombre_p1 += event.unicode
            elif caja_p2_activa:
                if event.key == pygame.K_BACKSPACE:
                    nombre_p2 = nombre_p2[:-1]
                elif len(nombre_p2) < 12 and event.unicode.isprintable():
                    nombre_p2 += event.unicode

        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            mouse_x, mouse_y = event.pos

            # --- MENÚ PRINCIPAL ---
            if ESTADO_JUEGO == "MENU":
                if btn_menu_jugar.collidepoint(event.pos):
                    ESTADO_JUEGO = "NOMBRES"
                elif btn_menu_reglas.collidepoint(event.pos):
                    ESTADO_JUEGO = "REGLAS"
                elif btn_menu_salir.collidepoint(event.pos):
                    running = False

            # --- PANTALLA REGISTRO DE NOMBRES ---
            elif ESTADO_JUEGO == "NOMBRES":
                if caja_input_p1.collidepoint(event.pos):
                    caja_p1_activa = True
                    caja_p2_activa = False
                    nombre_p1 = ""  # Limpia el campo al hacer clic
                elif caja_input_p2.collidepoint(event.pos):
                    caja_p1_activa = False
                    caja_p2_activa = True
                    nombre_p2 = ""  # Limpia el campo al hacer clic
                else:
                    caja_p1_activa = False
                    caja_p2_activa = False

                if btn_iniciar_partida.collidepoint(event.pos):
                    if nombre_p1.strip() == "": nombre_p1 = "Jugador 1"
                    if nombre_p2.strip() == "": nombre_p2 = "Jugador 2"
                    reiniciar_juego()
                    ESTADO_JUEGO = "JUEGO"

            # --- PANTALLA DE REGLAS ---
            elif ESTADO_JUEGO == "REGLAS":
                if btn_volver_menu.collidepoint(event.pos):
                    ESTADO_JUEGO = "MENU"

            # --- PANTALLA DE VICTORIA ---
            elif ESTADO_JUEGO == "VICTORIA":
                if btn_victoria_menu.collidepoint(event.pos):
                    ESTADO_JUEGO = "MENU"

            # --- PANTALLA DE JUEGO ---
            elif ESTADO_JUEGO == "JUEGO":

                # 1. LÓGICA ISLAND
                if modo_bounce:
                    campo_enemigo = cartas_campo_p2 if turno1 else cartas_campo_p1
                    mano_enemiga = lista_mano_2 if turno1 else lista_mano_1
                    y_campo_enemigo = 380 if turno1 else 200

                    devuelta = False
                    for i in range(len(campo_enemigo) - 1, -1, -1):
                        x_carta = 320 + (i * 75)
                        rect_carta_campo = pygame.Rect(x_carta, y_campo_enemigo, 90, 126)
                        
                        if rect_carta_campo.collidepoint(event.pos):
                            carta_devuelta = campo_enemigo.pop(i)
                            mano_enemiga.append(carta_devuelta)
                            devuelta = True
                            break

                    if devuelta or len(campo_enemigo) == 0:
                        modo_bounce = False

                # 2. LÓGICA SWAMP
                elif modo_swamp:
                    mano_enemiga = lista_mano_2 if turno1 else lista_mano_1
                    cementerio_enemigo = cartas_descarte_p2 if turno1 else cartas_descarte_p1
                    y_mano_enemiga = 550 if turno1 else 0

                    for i in range(len(mano_enemiga) - 1, -1, -1):
                        x_carta = 320 + (i * 85)
                        rect_carta = pygame.Rect(x_carta, y_mano_enemiga, 120, 168)

                        if rect_carta.collidepoint(event.pos):
                            carta_descartada = mano_enemiga.pop(i)
                            cementerio_enemigo.append(carta_descartada)
                            modo_swamp = False
                            break

                # 3. LÓGICA MONTAÑA
                elif modo_destruir:
                    campo_enemigo = cartas_campo_p2 if turno1 else cartas_campo_p1
                    cementerio_enemigo = cartas_descarte_p2 if turno1 else cartas_descarte_p1
                    y_campo_enemigo = 380 if turno1 else 200

                    destruida = False
                    for i in range(len(campo_enemigo) - 1, -1, -1):
                        x_carta = 320 + (i * 75)
                        rect_carta_campo = pygame.Rect(x_carta, y_campo_enemigo, 90, 126)
                        
                        if rect_carta_campo.collidepoint(event.pos):
                            carta_eliminada = campo_enemigo.pop(i)
                            cementerio_enemigo.append(carta_eliminada)
                            destruida = True
                            break

                    if destruida or len(campo_enemigo) == 0:
                        modo_destruir = False

                # 4. LÓGICA FOREST
                elif mostrar_popup_cementerio and modo_revivir:
                    if btn_cerrar_cem.collidepoint(event.pos):
                        mostrar_popup_cementerio = False
                        modo_revivir = False
                    else:
                        cementerio_propio = cartas_descarte_p1 if turno1 else cartas_descarte_p2
                        mano_propia = lista_mano_1 if turno1 else lista_mano_2
                        
                        for idx, nombre in enumerate(cementerio_propio):
                            pos_x_cem = pos_popup_cem[0] + 30 + (idx * 100)
                            pos_y_cem = pos_popup_cem[1] + 80
                            rect_carta_cem = pygame.Rect(pos_x_cem, pos_y_cem, 90, 126)
                            
                            if rect_carta_cem.collidepoint(event.pos):
                                carta_revivida = cementerio_propio.pop(idx)
                                mano_propia.append(carta_revivida)
                                mostrar_popup_cementerio = False
                                modo_revivir = False
                                break

                elif mostrar_popup_cementerio:
                    if btn_cerrar_cem.collidepoint(event.pos):
                        mostrar_popup_cementerio = False

                elif mostrar_popup:
                    mano_actual = lista_mano_1 if turno1 else lista_mano_2
                    
                    if btn_cancelar.collidepoint(event.pos):
                        mostrar_popup = False

                    elif btn_accion.collidepoint(event.pos):
                        if cartas_jugadas_turno >= 1:
                            popup_mensaje("¡Solo puedes jugar 1 carta por turno!")
                            pygame.time.delay(1200)
                        else:
                            if indice_carta_seleccionada is not None and indice_carta_seleccionada < len(mano_actual):
                                carta_quitada = mano_actual.pop(indice_carta_seleccionada)
                                
                                if turno1:
                                    cartas_campo_p1.append(carta_quitada)
                                else:
                                    cartas_campo_p2.append(carta_quitada)

                                cartas_jugadas_turno += 1

                                campo_actual = cartas_campo_p1 if turno1 else cartas_campo_p2
                                gano, motivo = verificar_victoria(campo_actual)
                                if gano:
                                    ganador_texto = f"¡{nombre_p1 if turno1 else nombre_p2} GANA!"
                                    motivo_victoria = motivo
                                    ESTADO_JUEGO = "VICTORIA"

                                campo_enemigo = cartas_campo_p2 if turno1 else cartas_campo_p1
                                mano_enemiga = lista_mano_2 if turno1 else lista_mano_1

                                # EFECTO SWAMP (SÓLO SE DESCARTA)
                                if carta_quitada == "Swamp" and len(mano_enemiga) > 0 and ESTADO_JUEGO == "JUEGO":
                                    modo_swamp = True

                                # EFECTO MONTAÑA
                                if carta_quitada == "Mountain" and len(campo_enemigo) > 0 and ESTADO_JUEGO == "JUEGO":
                                    modo_destruir = True

                                # EFECTO BOSQUE (FOREST)
                                cementerio_propio = cartas_descarte_p1 if turno1 else cartas_descarte_p2
                                if carta_quitada == "Forest" and len(cementerio_propio) > 0 and ESTADO_JUEGO == "JUEGO":
                                    modo_revivir = True
                                    cementerio_a_mostrar = cementerio_propio
                                    titulo_cementerio = f"Efecto Bosque: Elige una carta para revivir ({nombre_p1 if turno1 else nombre_p2})"
                                    mostrar_popup_cementerio = True

                                # EFECTO ISLAND (ISLA)
                                if carta_quitada == "Island" and len(campo_enemigo) > 0 and ESTADO_JUEGO == "JUEGO":
                                    modo_bounce = True

                                # EFECTO PLAINS (LLANURA)
                                if carta_quitada == "Plains" and ESTADO_JUEGO == "JUEGO":
                                    f = random.randint(1, 5)
                                    cartas_posibles = ["Forest", "Mountain", "Island", "Plains", "Swamp"]
                                    carta_extra = cartas_posibles[f - 1]
                                    if turno1:
                                        lista_mano_1.append(carta_extra)
                                    else:
                                        lista_mano_2.append(carta_extra)

                        mostrar_popup = False

                else:
                    if rect_descarte_p1.collidepoint(event.pos):
                        cementerio_a_mostrar = cartas_descarte_p1
                        titulo_cementerio = f"Cementerio - {nombre_p1}"
                        mostrar_popup_cementerio = True

                    elif rect_descarte_p2.collidepoint(event.pos):
                        cementerio_a_mostrar = cartas_descarte_p2
                        titulo_cementerio = f"Cementerio - {nombre_p2}"
                        mostrar_popup_cementerio = True

                    else:
                        mano_actual = lista_mano_1 if turno1 else lista_mano_2
                        y_mano = 0 if turno1 else 550
                        total_cartas = len(mano_actual)
                        
                        for i in range(total_cartas - 1, -1, -1):
                            nombre_carta = mano_actual[i]
                            x_carta = 320 + (i * 85)
                            rect_carta = pygame.Rect(x_carta, y_mano, 120, 168)
                            
                            if rect_carta.collidepoint(event.pos):
                                carta_seleccionada = IMAGENES_CARTAS[nombre_carta]
                                indice_carta_seleccionada = i
                                mostrar_popup = True
                                break

                    # Boton Pasar Turno
                    x_t = mouse_x - boton_turno_pos[0]
                    y_t = mouse_y - boton_turno_pos[1]
                    if 0 <= x_t < boton_turno.get_width() and 0 <= y_t < boton_turno.get_height():
                        if boton_mask_turno.get_at((x_t, y_t)):
                            turno1 = not turno1
                            Nrobos = 0
                            cartas_jugadas_turno = 0

                    # Boton Robar Carta
                    x_r = mouse_x - boton_robo_pos[0]
                    y_r = mouse_y - boton_robo_pos[1]
                    if Nrobos == 0:
                        if 0 <= x_r < boton_robo.get_width() and 0 <= y_r < boton_robo.get_height():
                            if boton_mask_robo.get_at((x_r, y_r)):
                                f = random.randint(1, 5)
                                cartas_posibles = ["Forest", "Mountain", "Island", "Plains", "Swamp"]
                                carta_robada = cartas_posibles[f - 1]
                                
                                if turno1:
                                    lista_mano_1.append(carta_robada)
                                else:
                                    lista_mano_2.append(carta_robada)
                                
                                Nrobos += 1

    # ==========================================
    # RENDERIZADO / DIBUJADO
    # ==========================================

    # --- PANTALLA: MENÚ PRINCIPAL ---
    if ESTADO_JUEGO == "MENU":
        screen.blit(fondo_oscuro, (0, 0))

        txt_titulo_game = fuente_titulo_grande.render("MAGIC LANDS", True, (255, 215, 0))
        rect_titulo_game = txt_titulo_game.get_rect(center=(ANCHO_PANTALLA // 2, 150))
        screen.blit(txt_titulo_game, rect_titulo_game)

        pygame.draw.rect(screen, (40, 180, 90), btn_menu_jugar)
        screen.blit(txt_menu_jugar, rect_menu_jugar)

        pygame.draw.rect(screen, (50, 120, 200), btn_menu_reglas)
        screen.blit(txt_menu_reglas, rect_menu_reglas)

        pygame.draw.rect(screen, (200, 50, 50), btn_menu_salir)
        screen.blit(txt_menu_salir, rect_menu_salir)

    # --- PANTALLA: INGRESO DE NOMBRES ---
    elif ESTADO_JUEGO == "NOMBRES":
        screen.blit(fondo_oscuro, (0, 0))

        txt_tit_nom = fuente_titulo_grande.render("JUGADORES", True, (255, 255, 255))
        rect_tit_nom = txt_tit_nom.get_rect(center=(ANCHO_PANTALLA // 2, 120))
        screen.blit(txt_tit_nom, rect_tit_nom)

        lbl_p1 = fuente_subtitulo.render("Nombre Jugador 1:", True, (255, 255, 255))
        screen.blit(lbl_p1, (caja_input_p1.x, caja_input_p1.y - 35))
        color_p1 = (255, 255, 255) if caja_p1_activa else (100, 100, 100)
        pygame.draw.rect(screen, (30, 30, 30), caja_input_p1)
        pygame.draw.rect(screen, color_p1, caja_input_p1, 2)
        txt_p1_val = fuente_subtitulo.render(nombre_p1, True, (255, 255, 255))
        screen.blit(txt_p1_val, (caja_input_p1.x + 10, caja_input_p1.y + 10))

        lbl_p2 = fuente_subtitulo.render("Nombre Jugador 2:", True, (255, 255, 255))
        screen.blit(lbl_p2, (caja_input_p2.x, caja_input_p2.y - 35))
        color_p2 = (255, 255, 255) if caja_p2_activa else (100, 100, 100)
        pygame.draw.rect(screen, (30, 30, 30), caja_input_p2)
